{
  "name": "rail-island-factory",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Procedurally generated Rail Island models, and the catalog site that shows them (factory.railisland.com)",
  "scripts": {
    "build:models": "tsx generator/generate.ts",
    "dev": "pnpm build:models && vite",
    "build": "pnpm build:models && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "solid-js": "^1.9.3",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.160.0",
    "esbuild": "^0.25.12",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
