{
  "$schema": "node_modules/wrangler/config-schema.json",
  // factory.railisland.com: an assets-only Worker (no script, no bindings, no
  // vars) that serves `pnpm build`'s output -- the catalog site plus the
  // generated models it lists. Deployed from `master` by
  // .github/workflows/deploy.yml. See docs/guide/deploy.md.
  "name": "rail-island-factory",
  "compatibility_date": "2026-06-16",
  "assets": {
    "directory": "./dist",
    // Every page is a prerendered file (docs/site/seo-pages.md): `/model/<id>/` is
    // model/<id>/index.html (the default html_handling, auto-trailing-slash, adds the
    // slash). Any other path answers 404.html with a 404 status: the app with a
    // noindex tag, which shows "No model ..." or the list.
    "not_found_handling": "404-page"
  },
  // Also serve on the account's implicit rail-island-factory.<subdomain>.workers.dev.
  // Wrangler turns that address off by default once `routes` is set, so it is
  // switched on explicitly here.
  "workers_dev": true,
  "routes": [
    { "pattern": "factory.railisland.com", "custom_domain": true }
  ]
}
