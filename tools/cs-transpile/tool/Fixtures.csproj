<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# transpiler's fixtures (tools/cs-transpile/fixtures.ts): the transpiled fixture
       module, the runtime and a console that prints each case's JSON. Generated into export/cs-fixtures/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS8632;CS0108;CS0162;CS0164;CS0168;CS0219;CS0649;CS1717;CS8981</NoWarn>
  </PropertyGroup>
</Project>
