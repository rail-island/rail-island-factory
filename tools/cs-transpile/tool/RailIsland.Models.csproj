<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# transpiler pilot's project (tools/cs-transpile): the transpiled designs,
       the runtime and a console that dumps and times them. Generated into export/cs/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RailIsland.Factory</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS8632;CS0108;CS0162;CS0168;CS0219;CS0649;CS1717;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jint" Version="4.1.0" />
  </ItemGroup>
</Project>
